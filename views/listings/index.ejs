<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
        transition: 0.2s;
    }
    .filter-link {
        text-decoration: none;
        color: inherit;
    }
    .filter:hover {
        opacity: 1;
        cursor: pointer;
        color: #fe424d;
    }
    .filter p {
        font-size: 0.8rem;
    }
    .tax-info {
        display: none;
    }
    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        align-items: center;
    }
    .no-results-box {
        border: 2px dashed #dee2e6 !important;
        max-width: 600px;
        margin: 0 auto;
    }
</style>

<div id="filters">
    <% const filterList = [
        { name: "Trending", icon: "fa-fire" },
        { name: "Rooms", icon: "fa-bed" },
        { name: "Iconic Cities", icon: "fa-mountain-city" },
        { name: "Mountains", icon: "fa-mountain" },
        { name: "Castles", icon: "fa-fort-awesome", brand: true },
        { name: "Amazing Pools", icon: "fa-person-swimming" },
        { name: "Camping", icon: "fa-campground" },
        { name: "Farms", icon: "fa-cow" },
        { name: "Arctic", icon: "fa-snowflake" },
        { name: "Domes", icon: "fa-igloo" },
        { name: "Boats", icon: "fa-ship" }
    ]; %>

    <% for(let f of filterList) { %>
        <a href="/listings?category=<%= f.name %>" class="filter-link">
            <div class="filter">
                <div><i class="<%= f.brand ? 'fa-brands' : 'fa-solid' %> <%= f.icon %>"></i></div>
                <p><%= f.name %></p>
            </div>
        </a>
    <% } %>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<% if (category || search) { %>
    <div class="mt-3 ms-2">
        <span>Results for <b>"<%= category || search %>"</b></span>
        <a href="/listings" class="ms-2 text-secondary text-decoration-none" style="font-size: 0.85rem;">
            <i class="fa-solid fa-circle-xmark"></i> Clear
        </a>
    </div>
<% } %>



<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% if(allListings.length > 0) { %>
        <% for(let listing of allListings) { %>
            <a href="/listings/<%=listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b> <br>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                            <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    <% } else { %>
        <div class="col-12 text-center mt-5">
            <div class="no-results-box p-5 bg-light rounded-4">
                <i class="fa-solid fa-magnifying-glass fa-3x mb-3 text-muted"></i>
                <h2>No listings found</h2>
                <p class="text-muted">We couldn't find any listings matching your selection.</p>
                <a href="/listings" class="btn btn-dark mt-2">Explore All Listings</a>
            </div>
        </div>
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for (let info of taxInfo) {
            info.style.display = (info.style.display !== "inline") ? "inline" : "none";
        }
    });
</script>